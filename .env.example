# Puerto HTTP de la API
PORT=3000

# Cadena de conexión de MongoDB Atlas (Connect > Drivers).
# Sustituye <usuario> y <contraseña> en tu .env local; nunca publiques los valores reales.
MONGODB_URI=mongodb+srv://<usuario>:<contraseña>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Base de datos sobre la que el usuario tiene el rol readWrite
MONGODB_DB_NAME=task_api
