# Puerto HTTP de la API
PORT=3000

# Cadena de conexión de MongoDB Atlas (Connect > Drivers).
# Sustituye los marcadores en tu .env local; nunca publiques los valores reales.
MONGODB_URI=mongodb+srv://<USUARIO>:<CONTRASENA_CODIFICADA>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority

# Base de datos sobre la que el usuario tiene el rol readWrite
MONGODB_DB_NAME=task_api

# Autenticación JWT (A9). Genera el secreto con:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
JWT_SECRET=<GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES>
JWT_EXPIRES_IN=1h
JWT_ISSUER=task-api-express
JWT_AUDIENCE=task-api-client
