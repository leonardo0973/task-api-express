# Ambiente: development, test o production (Render usa production)
NODE_ENV=development
# Versión publicada en /health y en OpenAPI
APP_VERSION=1.0.0

# Puerto HTTP de la API (Render asigna PORT automáticamente)
PORT=3000
# URL pública de la API, sin diagonal final. En Render: https://<servicio>.onrender.com
PUBLIC_API_URL=http://localhost:3000
# Saltos de proxy de confianza: 0 en local, 1 detrás del proxy HTTPS de Render
TRUST_PROXY_HOPS=0

# Cadena de conexión de MongoDB Atlas (Connect > Drivers).
# Sustituye los marcadores en tu .env local; nunca publiques los valores reales.
MONGODB_URI=mongodb+srv://<USUARIO>:<CONTRASENA_CODIFICADA>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority

# Base de datos sobre la que el usuario tiene el rol readWrite
MONGODB_DB_NAME=task_api

# Autenticación JWT (A9). Genera el secreto con:
# node --input-type=module -e "import { randomBytes } from 'node:crypto'; console.log(randomBytes(32).toString('hex'))"
JWT_SECRET=<GENERA_UN_SECRETO_ALEATORIO_DE_AL_MENOS_32_BYTES>
JWT_EXPIRES_IN=1h
JWT_ISSUER=task-api-express
JWT_AUDIENCE=task-api-client

# Controles HTTP (A10). Origen exacto del frontend: esquema, host y puerto, sin ruta final.
CORS_ORIGIN=http://localhost:5173
# Límite de registro e inicio de sesión: 10 solicitudes por IP cada 900000 ms (15 minutos)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
