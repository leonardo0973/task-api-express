                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.admin.a10@example.com\",\n  \"password\": \"Frase segura para clase 2026\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
