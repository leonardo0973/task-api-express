{
  "info": {
    "_postman_id": "fbd54162-1a60-426e-b6d7-3b0c2d418e53",
    "name": "Task API EC3 F2 A10",
    "description": "EC3 F2 A10: Bearer JWT, roles y controles HTTP. Selecciona el entorno 'A10 local' y ejecuta con el Runner con la API recién iniciada (el límite de autenticación es de 10 solicitudes por IP cada 15 minutos). La cuenta postman.admin.a10@example.com se promueve con: pnpm role:set postman.admin.a10@example.com admin",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 Rutas públicas",
      "item": [
        {
          "name": "GET /health (Helmet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.code === 204 ? null : pm.response.json();",
                  "pm.test('Código 200 · requestId ' + pm.response.headers.get('X-Request-Id'), () => pm.response.to.have.status(200));",
                  "pm.test('Helmet: X-Content-Type-Options nosniff', () => pm.expect(pm.response.headers.get('X-Content-Type-Options')).to.eql('nosniff'));",
                  "pm.test('Sin X-Powered-By', () => pm.expect(pm.response.headers.has('X-Powered-By')).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST /api/auth/register",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userEmail', `ana.torres.postman.${Date.now()}@example.com`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.code === 204 ? null : pm.response.json();",
                  "pm.test('Código 201 · requestId ' + pm.response.headers.get('X-Request-Id'), () => pm.response.to.have.status(201));",
                  "pm.test('Cuenta user sin passwordHash', () => { pm.expect(body.data.user.role).to.eql('user'); pm.expect(pm.response.text()).to.not.include('passwordHash'); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Frase segura para clase 2026\",\n  \"confirmPassword\": \"Frase segura para clase 2026\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST /api/auth/login (user)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.code === 204 ? null : pm.response.json();",
                  "pm.test('Código 200 · requestId ' + pm.response.headers.get('X-Request-Id'), () => pm.response.to.have.status(200));",
                  "const setVar = (k, v) => (pm.environment.name ? pm.environment.set(k, v) : pm.collectionVariables.set(k, v));",
                  "pm.test('JWT Bearer con role user', () => { pm.expect(body.data.tokenType).to.eql('Bearer'); pm.expect(body.data.user.role).to.eql('user'); });",
                  "setVar('userToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Frase segura para clase 2026\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "POST /api/auth/login (admin promovido con pnpm role:set)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.code === 204 ? null : pm.response.json();",
                  "pm.test('Código 200 · requestId ' + pm.response.headers.get('X-Request-Id'), () => pm.response.to.have.status(200));",
                  "const setVar = (k, v) => (pm.environment.name ? pm.environment.set(k, v) : pm.collectionVariables.set(k, v));",
                  "pm.test('role admin en el nuevo token', () => pm.expect(body.data.user.role).to.eql('admin'));",
                  "setVar('adminToken', body.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
