              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.collectionVariables.get('intentos') || 0) + 1;",
                  "pm.collectionVariables.set('intentos', n);",
                  "if (pm.response.code !== 429 && n < 15) {",
                  "  pm.test(`Intento ${n}: ${pm.response.code} (aún dentro del límite)`, () => pm.expect(pm.response.code).to.be.oneOf([401, 429]));",
                  "  pm.execution.setNextRequest(pm.info.requestName);",
                  "} else {",
                  "  const body = pm.response.json();",
                  "  pm.test(`429 AUTH_RATE_LIMIT_EXCEEDED tras ${n} intentos · requestId ` + pm.response.headers.get('X-Request-Id'), () => { pm.expect(pm.response.code).to.eql(429); pm.expect(body.error.code).to.eql('AUTH_RATE_LIMIT_EXCEEDED'); });",
                  "  pm.collectionVariables.set('intentos', 0);",
                  "}"
                ]
              }
            }
