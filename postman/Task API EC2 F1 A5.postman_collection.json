  "item": [
    {
      "name": "1. Infraestructura",
      "item": [
        {
          "name": "GET /health",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye X-Request-Id', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string'));",
                  "pm.test('status ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "GET /health/database (conectado)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 200', () => pm.response.to.have.status(200));",
                  "pm.test('Incluye X-Request-Id', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string'));",
                  "pm.test('ping ok', () => pm.expect(pm.response.json().data.ping).to.eql('ok'));",
                  "pm.test('base task_api', () => pm.expect(pm.response.json().data.database).to.eql('task_api'));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/database",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "database"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "GET /health/database (sin red → 503)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Estado 503', () => pm.response.to.have.status(503));",
                  "pm.test('Incluye X-Request-Id', () => pm.expect(pm.response.headers.get('X-Request-Id')).to.be.a('string'));",
                  "pm.test('Código DATABASE_UNAVAILABLE', () => pm.expect(pm.response.json().error.code).to.eql('DATABASE_UNAVAILABLE'));",
                  "pm.test('requestId coincide', () => pm.expect(pm.response.json().error.requestId).to.eql(pm.response.headers.get('X-Request-Id')));",
                  "pm.test('No expone datos internos', () => { const t = pm.response.text(); ['mongodb+srv','mongodb.net','stack','Mongoose'].forEach(s => pm.expect(t).to.not.include(s)); });"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/database",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health",
                "database"
              ]
            },
            "description": "Desactiva la red con la API en marcha y espera unos segundos antes de enviar."
          }
        }
      ]
