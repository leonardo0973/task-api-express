{
  "info": {
    "_postman_id": "a78b8908-27e6-409f-bca7-033bb73eadd2",
    "name": "Task API EC3 F1 A9",
    "description": "EC3 F1 A9: registro, inicio de sesión, bcrypt y JWT. Ejecuta con el Runner y la API encendida. El token no se guarda en variables: solo se decodifican sus claims para inspección educativa.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "P1 POST /api/auth/register",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const s = Date.now();",
              "pm.collectionVariables.set('email', `ana.torres.${s}@example.com`);",
              "pm.collectionVariables.set('emailUpper', `Ana.Torres.${s}@example.com`);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.code === 204 ? null : pm.response.json();",
              "pm.test('Código 201 · requestId ' + pm.response.headers.get('X-Request-Id'), () => pm.response.to.have.status(201));",
              "pm.test('data.user público con role user', () => { const u = body.data.user; pm.expect(u).to.have.all.keys('id','name','email','role','createdAt','updatedAt'); pm.expect(u.role).to.eql('user'); });",
              "pm.test('Correo normalizado a minúsculas', () => pm.expect(body.data.user.email).to.eql(pm.collectionVariables.get('email')));",
              "pm.test('No contiene password ni passwordHash', () => pm.expect(pm.response.text()).to.not.match(/password/i));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ana Torres\",\n  \"email\": \"{{emailUpper}}\",\n  \"password\": \"Frase segura para clase 2026\",\n  \"confirmPassword\": \"Frase segura para clase 2026\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "P2 POST /api/auth/login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.code === 204 ? null : pm.response.json();",
              "pm.test('Código 200 · requestId ' + pm.response.headers.get('X-Request-Id'), () => pm.response.to.have.status(200));",
              "pm.test('user, accessToken, tokenType Bearer, expiresIn 1h', () => { pm.expect(body.data).to.have.all.keys('user','accessToken','tokenType','expiresIn'); pm.expect(body.data.tokenType).to.eql('Bearer'); pm.expect(body.data.expiresIn).to.eql('1h'); });",
              "pm.test('El usuario público no incluye passwordHash', () => pm.expect(pm.response.text()).to.not.include('passwordHash'));",
              "const claims = JSON.parse(atob(body.data.accessToken.split('.')[1].replace(/-/g, '+').replace(/_/g, '/')));",
              "pm.test('Claims (inspección educativa): ' + Object.keys(claims).join(', '), () => { pm.expect(claims.sub).to.eql(body.data.user.id); pm.expect(claims.role).to.eql('user'); pm.expect(claims.iss).to.eql('task-api-express'); pm.expect(claims.aud).to.eql('task-api-client'); pm.expect(claims.exp - claims.iat).to.eql(3600); pm.expect(claims).to.not.have.property('email'); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
